  "description": "The easiest way to run AmneziaWG VPN + Web-based Admin UI.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && pnpm cli:build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier . --write",
