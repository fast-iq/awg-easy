    "@phc/format": "^1.0.0",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/forms": "^0.5.10",
    "@vueuse/core": "^14.0.0",
    "@vueuse/nuxt": "^14.0.0",
    "apexcharts": "^5.3.5",
    "argon2": "^0.44.0",
    "cidr-tools": "^11.0.3",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
